{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDFShift API Documentation account Logs API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get log by request ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pdfshift.io/v3/logs/:request_id",
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path",
                "description": "The unique request ID of the log entry to retrieve."
              }
            ]
          },
          "docs": "Get log by request ID"
        },
        {
          "info": {
            "name": "List recent logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pdfshift.io/v3/logs",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return (between 5 and 100, defaults to 20)"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter logs by status: 'error', 'success', or 'all' (default: 'all')"
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "API Key to filter the results to. Default is null, which includes all requests from all API keys."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Returns the items that occur after the given log ID."
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Returns the events that occurred before the given time. Format is ISO datetime."
              }
            ]
          },
          "docs": "List recent logs"
        }
      ]
    }
  ],
  "bundled": true
}