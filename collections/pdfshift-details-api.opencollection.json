{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDFShift API Documentation account details API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "details",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pdfshift.io/v3/account"
          },
          "docs": "Returns the account details for the connected API Key"
        }
      ]
    }
  ],
  "bundled": true
}